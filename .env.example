# FLOW: Next.js on Vercel + Supabase database/Auth/Realtime. No demo data.
# Copy to .env.local only when that file does not already exist.

# PUBLIC browser configuration (safe to expose; RLS must still be enabled).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
NEXT_PUBLIC_FLOW_MAP_STYLE_LIGHT=https://tiles.openfreemap.org/styles/positron
NEXT_PUBLIC_FLOW_MAP_STYLE_DARK=https://tiles.openfreemap.org/styles/dark

# PRIVATE server credentials. NEVER prefix any of these with NEXT_PUBLIC_.
# Modern Supabase secret key (sb_secret_...) or legacy service-role credential.
SUPABASE_SECRET_KEY=

# Optional AI: leave blank for a clearly labeled evidence-based fallback.
GEMINI_API_KEY=
# Choose a model in your Google AI Studio account supporting structured JSON.
GEMINI_MODEL=
AI_REQUESTS_PER_MINUTE=10

# Optional Web Push. Generate once with: npm run vapid
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
PUSH_WORKER_SECRET=

# Optional exact browser origin allowlist. Usually omit: same-origin is automatic.
# When used, set separately for localhost and your deployment (no trailing slash).
SITE_ORIGIN=
