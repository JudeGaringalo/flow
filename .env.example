# Public browser configuration; the map reads only permitted sensor columns.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Private Next.js server configuration. Do not prefix either with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
FLOW_INSTALLER_SECRET=

# Optional: restrict browser-origin requests to your production site.
SITE_ORIGIN=
