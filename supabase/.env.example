# Set these using `supabase secrets set --env-file supabase/.env.local`.
# Never commit the real .env.local.
SITE_ORIGIN=https://your-flow-site.example
FLOW_SERVER_KEY=YOUR_SUPABASE_SERVER_SECRET_KEY
GEMINI_API_KEY=YOUR_GOOGLE_AI_STUDIO_API_KEY
# Select a currently available model in your AI Studio project; quota is account-specific.
GEMINI_MODEL=gemini-2.5-flash-lite
AI_REQUESTS_PER_MINUTE=10
VAPID_PUBLIC_KEY=GENERATE_WITH_NPM_RUN_VAPID
VAPID_PRIVATE_KEY=GENERATE_WITH_NPM_RUN_VAPID
VAPID_SUBJECT=mailto:YOUR_REAL_CONTACT_EMAIL
PUSH_WORKER_SECRET=GENERATE_A_LONG_RANDOM_SECRET
